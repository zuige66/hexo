<div id="toc">
  <p class="toc-header">
    <i class="iconfont icon-list"></i>
    <span><%- __('post.toc') %></span>
  </p>
  <div class="toc-body" id="toc-body"></div>
</div>

<%
import_script(`
<script>
  Fluid.utils.createScript('${url_join(theme.static_prefix.tocbot, 'tocbot.min.js')}', function() {
    var toc = jQuery('#toc');
    if (toc.length === 0 || !window.tocbot) { return; }
    var boardCtn = jQuery('#board-ctn');
    var boardTop = boardCtn.offset().top;

    function isExpandAllEnabled() {
      return CONFIG.toc && CONFIG.toc.expand_all === true;
    }
    function expandAllToc() {
      if (!isExpandAllEnabled()) { return; }
      jQuery('#toc-body .tocbot-is-collapsed').removeClass('tocbot-is-collapsed');
    }
    function updateTocToggle($li, $childList) {
      var $toggle = $li.children('.toc-line').children('.toc-toggle');
      if ($toggle.length === 0) { return; }
      var collapsed = $childList.hasClass('tocbot-is-collapsed');
      $toggle
        .toggleClass('toc-toggle-collapsed', collapsed)
        .toggleClass('toc-toggle-expanded', !collapsed)
        .attr('aria-expanded', String(!collapsed))
        .attr('aria-label', collapsed ? '展开子目录' : '收起子目录');
      $childList.attr('aria-hidden', String(collapsed));
    }
    function bindTocToggle() {
      if (!isExpandAllEnabled()) { return; }
      jQuery('#toc-body .toc-list-item').each(function() {
        var $li = jQuery(this);
        var $childList = $li.children('ol');
        var $line = $li.children('.toc-line');
        var $link = $li.children('.tocbot-link');

        if ($line.length === 0 && $link.length > 0) {
          $link.wrap('<div class="toc-line"></div>');
          $line = $li.children('.toc-line');
        }

        $li.children('.toc-toggle').remove();
        $line.children('.toc-toggle').remove();
        if ($childList.length === 0) {
          $line.addClass('toc-line-leaf');
          return;
        }

        $line.removeClass('toc-line-leaf');
        $line.prepend('<span class="toc-toggle toc-toggle-expanded" role="button" tabindex="0">›</span>');
        updateTocToggle($li, $childList);
      });
      jQuery('#toc-body').off('click.tocToggle').on('click.tocToggle', '.toc-toggle', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var $li = jQuery(this).closest('.toc-list-item');
        var $childList = $li.children('ol');
        if ($childList.length === 0) { return; }
        $childList.toggleClass('tocbot-is-collapsed');
        updateTocToggle($li, $childList);
      });
      jQuery('#toc-body').off('keydown.tocToggle').on('keydown.tocToggle', '.toc-toggle', function(e) {
        if (e.key !== 'Enter' && e.key !== ' ') { return; }
        e.preventDefault();
        jQuery(this).trigger('click');
      });
      if (window.__tocToggleObserver) {
        window.__tocToggleObserver.disconnect();
      }
      window.__tocToggleObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type !== 'attributes' || mutation.attributeName !== 'class') { return; }
          var $list = jQuery(mutation.target);
          var $li = $list.parent('.toc-list-item');
          if ($li.length === 0) { return; }
          updateTocToggle($li, $list);
        });
      });
      jQuery('#toc-body ol').each(function() {
        window.__tocToggleObserver.observe(this, { attributes: true });
      });
    }
    // 让「当前位置高亮」和「点击跳转落点」都对齐到视口上 1/3。
    // 关键：tocbot 4.x 判定 active 时用 heading.offsetTop（相对文章容器），
    // 比较基准却是文档 scrollTop，二者差一个 boardTop，所以必须保留 -boardTop 补偿，
    // 否则高亮会错位一节。在这个补偿上再加 vh/3，把高亮边界从视口顶部移到 1/3 处。
    // scrollSmoothOffset 独立控制点击落点：负值 = 目标标题停在视口下方这个距离。
    var readOffset = Math.round(window.innerHeight / 3);
    var tocConfig = Object.assign({
      tocSelector        : '#toc-body',
      contentSelector    : '.markdown-body',
      linkClass          : 'tocbot-link',
      activeLinkClass    : 'tocbot-active-link',
      listClass          : 'tocbot-list',
      isCollapsedClass   : 'tocbot-is-collapsed',
      collapsibleClass   : 'tocbot-is-collapsible',
      scrollSmooth       : true,
      includeTitleTags   : true,
      headingsOffset     : -boardTop + readOffset,
      scrollSmoothOffset : -readOffset,
    }, CONFIG.toc);
    if (isExpandAllEnabled()) {
      tocConfig.collapseDepth = 6;
    }
    window.tocbot.init(tocConfig);
    if (toc.find('.toc-list-item').length > 0) {
      toc.css('visibility', 'visible');
    }
    expandAllToc();
    bindTocToggle();

    // 让右侧目录容器（.toc-body 有 overflow-y:auto）自动跟随当前阅读项：
    // tocbot 只负责加 active 类，不会滚动这个内部容器，页面下滑时蓝色卡片会一路
    // 贴到容器底部甚至被裁掉。这里在 active 项变化后把卡片平滑送回容器高度 1/3 处，
    // 上留 1/3、下留 2/3，不贴边——只要偏离 1/3 就归位，不做「贴边才跟随」的舒适区，
    // 否则卡片常停在容器顶部/25% 处，看起来就像没跟随。
    // 手动滚轮/触摸目录后 2 秒内暂停跟随，避免被硬拽回。
    var tocBody = document.getElementById('toc-body');
    var manualUntil = 0;
    var lastFollow = 0;
    var ensureActiveVisible = function() {
      if (!tocBody || Date.now() < manualUntil) { return; }
      if (Date.now() - lastFollow < 300) { return; } // 节流，防止 smooth 滚动期间反复 scrollTo 打断动画
      var active = tocBody.querySelector('.tocbot-active-link');
      if (!active) { return; }
      // 内容没超出容器（无内部滚动条）时 scrollTop 恒为 0，无需跟随。
      if (tocBody.scrollHeight <= tocBody.clientHeight + 1) { return; }
      var cRect = tocBody.getBoundingClientRect();
      var aRect = active.getBoundingClientRect();
      var pos = aRect.top - cRect.top; // 卡片顶部在容器可视区内的位置
      var targetPos = cRect.height / 3; // 始终让卡片顶部停在容器 1/3 处
      if (Math.abs(pos - targetPos) > 6) {
        lastFollow = Date.now();
        // scrollTop + pos = 卡片顶部相对容器内容顶的位置，减去 1/3 容器高即为目标 scrollTop。
        var target = tocBody.scrollTop + pos - targetPos;
        target = Math.max(0, Math.min(target, tocBody.scrollHeight - tocBody.clientHeight));
        tocBody.scrollTo({ top: target, behavior: 'smooth' });
      }
    };
    if (tocBody) {
      tocBody.addEventListener('wheel', function() { manualUntil = Date.now() + 2000; }, { passive: true });
      tocBody.addEventListener('touchstart', function() { manualUntil = Date.now() + 2000; }, { passive: true });
      // 页面滚动停止后归位（主驱动）：不依赖 active 类变化的捕获时机。
      // 只监听 window 滚动——tocBody 自身的 smooth 滚动不冒泡到这里，不会自激循环。
      var scrollTimer = null;
      window.addEventListener('scroll', function() {
        if (scrollTimer) { clearTimeout(scrollTimer); }
        scrollTimer = setTimeout(ensureActiveVisible, 160);
      }, { passive: true });
      // active 类变化立即响应一次（补充，减少等待感）；节流由 ensureActiveVisible 内部保证。
      if (window.__tocActiveObserver) { window.__tocActiveObserver.disconnect(); }
      window.__tocActiveObserver = new MutationObserver(function(muts) {
        for (var i = 0; i < muts.length; i++) {
          var t = muts[i].target;
          if (t && t.classList && t.classList.contains('tocbot-active-link')) {
            ensureActiveVisible();
            break;
          }
        }
      });
      window.__tocActiveObserver.observe(tocBody, { attributes: true, subtree: true, attributeFilter: ['class'] });
    }
    setTimeout(ensureActiveVisible, 0);

    Fluid.events.registerRefreshCallback(function() {
      if ('tocbot' in window) {
        tocbot.refresh();
        var toc = jQuery('#toc');
        if (toc.length === 0 || !tocbot) {
          return;
        }
        if (toc.find('.toc-list-item').length > 0) {
          toc.css('visibility', 'visible');
        }
        expandAllToc();
        bindTocToggle();
        setTimeout(ensureActiveVisible, 0);
      }
    });
  });
</script>
`)
%>
