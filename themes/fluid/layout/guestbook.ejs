<%
page.layout = "guestbook";
page.banner_img_height = page.banner_img_height || 60;
page.banner_mask_alpha = page.banner_mask_alpha || 0.3;
page.subtitle = page.subtitle || "欢迎留言交流 · 申请友链请按友链页格式留下信息";
%>

<article class="about-content page-content mt-5">
  <div class="markdown-body">
    <%- page.content %>
  </div>

  <% if(page.comments) { %>
    <!-- Comments -->
    <article id="comments">
      <% var type %>
      <% if (typeof page.comment === 'string' && page.comment !== '') { %>
        <% type = '_partials/comments/' + page.comment %>
      <% } else { %>
        <% type = '_partials/comments/' + theme.post.comments.type %>
      <% } %>
      <%- partial(type) %>
    </article>
  <% } %>
</article>

<%- partial('_partials/markdown-plugins') %>
