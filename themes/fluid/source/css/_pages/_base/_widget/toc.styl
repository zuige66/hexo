#toc
  visibility hidden

.toc-header
  margin-bottom .5rem
  font-weight bold
  line-height 1.2

  &, & > i
    font-size 1.25rem

.toc-body
  max-height 75vh
  overflow-y auto
  line-height 1.35
  overflow -moz-scrollbars-none
  -ms-overflow-style none

  ol
    list-style none
    padding-inline-start .7rem

  &::-webkit-scrollbar
    display none

.tocbot-list
  position relative
  margin 0

  ol
    list-style none
    padding-left .75rem
    margin .08rem 0

  a
    font-size 0.95rem

  ol a
    font-size 0.85rem

.tocbot-link
  color var(--text-color)

.toc-toggle
  display inline-block
  flex 0 0 .8rem
  width .8rem
  text-align center
  margin-right .2rem
  cursor pointer
  user-select none
  color var(--text-color)
  font-size .9rem
  line-height 1
  transition transform .2s ease-in-out

  &.toc-toggle-collapsed
    transform rotate(0deg)

  &.toc-toggle-expanded
    transform rotate(90deg)

.toc-line
  display flex
  align-items center
  min-width 0

  .tocbot-link
    flex 1 1 auto
    min-width 0
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

  &.toc-line-leaf
    padding-left 1rem


.tocbot-active-link
  font-weight bold
  color var(--link-hover-color)

.tocbot-is-collapsed
  max-height 0

.tocbot-is-collapsible
  overflow hidden
  transition all .3s ease-in-out

.toc-list-item
  padding .02rem 0
  display block
  overflow visible

  &.is-active-li::before
    height 1rem
    margin 0.25rem 0
    visibility visible

  &::before
    width 0.15rem
    height 0.2rem
    position absolute
    left 0.25rem
    content ""
    border-radius 2px
    margin 0.65rem 0
    background var(--link-hover-color)
    visibility hidden
    transition height .1s ease-in-out, margin .1s ease-in-out, visibility .1s ease-in-out

.sidebar
  position -webkit-sticky
  position sticky
  top 2rem
  padding 3rem 0
